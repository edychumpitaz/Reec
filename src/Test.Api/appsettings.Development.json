{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        //"Microsoft": "Information",
        //"Microsoft.Hosting.Lifetime": "Information"
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {RequestId,13} [{Level:u3}] {Message:lj} {Properties} {NewLine}{Exception}",
          "path": "./LogFile/ApiInternaLog-.txt", //ruta dentro de la aplicacion
          //"path": "C:\\Logs\\ApiInternaLog-.txt", //ruta fisica del archivo
          //"path": "C:/Logs/ApiInternaLog-.txt", //ruta fisica del archivo
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=asus\\sql2019;Initial Catalog=BD_REEC;Persist Security Info=True;User ID=sa;Password=Chump1taz; App=Shared.Api; TrustServerCertificate=True;"
  }
}
